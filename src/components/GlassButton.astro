---
interface Props {
  href: string;
  variant?: 'default' | 'accent';
}

const { href, variant = 'default' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'glass inline-block px-6 py-3 rounded-xl text-sm font-medium transition-all duration-300 hover:scale-105',
    variant === 'accent'
      ? 'bg-[var(--color-accent)]/10 text-[var(--color-accent)] border-[var(--color-accent)]/20 hover:bg-[var(--color-accent)]/20'
      : 'text-[var(--color-text)] hover:bg-white/10',
  ]}
>
  <slot />
</a>
