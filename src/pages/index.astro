---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import GlassPanel from '../components/GlassPanel.astro';
import Footer from '../components/Footer.astro';
import ComingSoonOverlay from '../components/ComingSoonOverlay.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => ({
    title: data.title,
    description: data.description,
    href: data.status === 'coming-soon' ? '#' : (data.url ?? data.github ?? '#'),
    size: data.size,
    comingSoon: data.status === 'coming-soon',
  }));
---

<BaseLayout title="Rio Zelaya">
  <Nav />

  <!-- Hero -->
  <section class="relative z-0 flex items-center justify-center px-6 pt-24 pb-16 isolate">
    <div class="max-w-2xl text-center" data-parallax>
      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-white fade-in">
        Rio Zelaya
      </h1>
      <p class="mt-6 text-lg text-[#888888] leading-relaxed fade-in fade-in-delay-1">
        I build things and figure it out along the way.
      </p>
    </div>
  </section>

  <!-- Projects — Floating glass panels -->
  <section class="relative z-0 px-4 sm:px-6 max-w-6xl mx-auto pb-20">
    <div class="panels-grid">
      {projects.map((project, i) => (
        <div class="scroll-fade" style={`transition-delay: ${i * 0.06}s`}>
          <GlassPanel
            title={project.title}
            description={project.description}
            href={project.href}
            size={project.size}
            comingSoon={project.comingSoon}
          />
        </div>
      ))}
    </div>
  </section>

  <Footer />

  <ComingSoonOverlay />
</BaseLayout>

<style>
  .panels-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .panels-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .panels-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
